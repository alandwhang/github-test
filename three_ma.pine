//@version=6
indicator("三條均線 (3 MA)", overlay = true)

// ===== 均線 1 =====
show1 = input.bool(true, "顯示 MA1", group = "MA1")
len1  = input.int(5, "MA1 週期", minval = 1, group = "MA1")

// ===== 均線 2 =====
show2 = input.bool(true, "顯示 MA2", group = "MA2")
len2  = input.int(20, "MA2 週期", minval = 1, group = "MA2")

// ===== 均線 3 =====
show3 = input.bool(true, "顯示 MA3", group = "MA3")
len3  = input.int(60, "MA3 週期", minval = 1, group = "MA3")

// ===== 計算 =====
ma1 = ta.sma(close, len1)
ma2 = ta.sma(close, len2)
ma3 = ta.sma(close, len3)

// ===== 繪圖（關閉時回傳 na 即不顯示）=====
plot(show1 ? ma1 : na, "MA1", color = color.yellow, linewidth = 2)
plot(show2 ? ma2 : na, "MA2", color = color.aqua,   linewidth = 2)
plot(show3 ? ma3 : na, "MA3", color = color.fuchsia, linewidth = 2)
